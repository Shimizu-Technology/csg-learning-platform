# ============================================
# CSG Learning Platform — API Environment
# ============================================

# Frontend URL for CORS (must match exactly, no trailing slash)
FRONTEND_URL=http://localhost:5173

# ---- Clerk Authentication ----

# Clerk issuer URL (from Clerk dashboard → JWT Templates or API Keys)
CLERK_ISSUER=https://your-app.clerk.accounts.dev

# Clerk Backend API key (optional — for enriching user data when JWT lacks email/name)
# CLERK_SECRET_KEY=sk_test_...

# Optional: explicit JWKS URL (overrides CLERK_ISSUER-based URL)
# CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json

# Optional: JWT audience verification
# CLERK_AUDIENCE=https://your-api-audience.example.com

# Optional: authorized-party allowlist for the token azp claim
# CLERK_AUTHORIZED_PARTIES=http://localhost:5173

# ---- Clerk development → production transition (production only) ----
# Keep the single CLERK_* variables above for local development. During the
# production cutover, configure both instances explicitly and select the
# environment used for invitations and mobile-to-web handoffs.
# CLERK_DEVELOPMENT_ISSUER=https://your-app.clerk.accounts.dev
# CLERK_DEVELOPMENT_SECRET_KEY=sk_test_...
# CLERK_DEVELOPMENT_AUTHORIZED_PARTIES=https://learn.codeschoolofguam.com
# CLERK_PRODUCTION_ISSUER=https://clerk.learn.codeschoolofguam.com
# CLERK_PRODUCTION_SECRET_KEY=sk_live_...
# CLERK_PRODUCTION_AUTHORIZED_PARTIES=https://learn.codeschoolofguam.com
# Keep this on development until the Netlify production-key cutover.
# CLERK_PRIMARY_ENVIRONMENT=development

# ---- Email (Resend) ----

# Resend API key for transactional emails (invite emails)
# Get from https://resend.com/api-keys
# RESEND_API_KEY=re_...

# From address for outgoing emails
MAILER_FROM_EMAIL=noreply@codeschoolofguam.com

# ---- PWA Push Notifications ----

# Optional for Phase 4. Generate with:
# bundle exec rails runner 'keys = WebPush.generate_key; puts keys.public_key; puts keys.private_key'
# WEB_PUSH_PUBLIC_KEY=...
# WEB_PUSH_PRIVATE_KEY=...
# WEB_PUSH_SUBJECT=mailto:leon@codeschoolofguam.com

# ---- GitHub Integration ----

# Personal access token with `repo` scope for syncing student repos and org invitations
# GITHUB_ORGANIZATION_ADMIN_TOKEN=ghp_...

# ---- AWS S3 (Self-Hosted Recordings) ----

# Required for video uploads. Create an S3 bucket and IAM user with s3:PutObject,
# s3:GetObject, s3:DeleteObject, s3:ListBucket permissions on the bucket.
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-bucket-name

# ---- Reviewed Voice Drafts (OpenAI, server-side only) ----

# Keep false until CSG's privacy disclosure and production data-control review are complete.
VOICE_TRANSCRIPTION_ENABLED=false
# OPENAI_API_KEY=your-server-only-openai-project-key
# OPENAI_PROJECT_ID=proj_...
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_CLEANUP_MODEL=gpt-5.6-luna
# OPENAI_API_BASE_URL=https://api.openai.com

# ---- Database ----

# Production only (Neon PostgreSQL) — local dev uses Rails defaults
# DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require
