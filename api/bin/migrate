#!/usr/bin/env ruby
require_relative "../lib/migration_database"

begin
  environment = MigrationDatabase.environment(ENV)
  # Validate before Rails parses a possibly malformed URL. Errors stay redacted.
  MigrationDatabase.verify!({ url: environment.fetch("DATABASE_URL", ENV["DATABASE_URL"]) })
rescue MigrationDatabase::UnsafeConnection => error
  abort error.message
end

# exec's environment changes affect only this child, not the parent web process.
exec(environment, File.expand_path("rails", __dir__), "db:prepare")
